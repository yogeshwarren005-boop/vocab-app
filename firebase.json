{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "main app/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Vocab App",
        "supportEmail": "yogeshwarren005@gmail.com",
        "authorizedRedirectUris": [
          "https://vocabapp-fdf4f.firebaseapp.com/__/auth/handler",
          "http://localhost:3080",
          "http://localhost"
        ]
      }
    }
  }
}
