{
  "name": "vocab-app",
  "version": "1.0.0",
  "description": "Mobile-First Vocab App with Multi-Provider Firebase Auth, Animated Vector Avatars, and Real-Time Cloud Firestore Tracking",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "index": "node server.mjs --index-only",
    "reindex": "node scripts/reindex.mjs",
    "verify-db": "node scripts/verify-database-tree.mjs",
    "sync-db": "node scripts/sync-app-database.mjs",
    "build": "node build-static.mjs",
    "cap:sync": "npm run index && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run cap:sync && cd ../android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.5",
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "firebase-admin": "^14.5.0"
  }
}
